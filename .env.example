# Server Configuration
PORT=8012
LOG_LEVEL=info

# Database
DB_PATH=./data/govupdate.db

# Cron Schedule (Daily at 10:00 AM IST)
# Format: minute hour day month day-of-week
# "0 10 * * *" = Every day at 10:00
CRON_SCHEDULE="0 10 * * *"

# RSS Feed URL (SEBI)
RSS_FEED_URL=https://www.sebi.gov.in/sebiweb/rss/sebi_rss.xml

# Optional OpenClaw browser integration
# Required for some JS-rendered or anti-bot-sensitive live source fetches.
# If omitted, browser-backed scrapers will not work.
OPENCLAW_BROWSER_CONTROL_URL=http://127.0.0.1:18791
OPENCLAW_GATEWAY_TOKEN=replace-me
OPENCLAW_BROWSER_PROFILE=openclaw
